{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "papertopia-ai-engine",
  "main": "worker.js",
  "compatibility_date": "2026-11-20",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}